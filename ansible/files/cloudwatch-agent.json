{
  "agent": {"region":"ap-northeast-1","metrics_collection_interval":60,"omit_hostname":true},
  "metrics": {
    "namespace":"DiscordManagementGatewayHost",
    "append_dimensions":{"InstanceId":"${aws:InstanceId}"},
    "metrics_collected": {
      "mem":{"measurement":["mem_used_percent"],"metrics_collection_interval":60},
      "disk":{"measurement":["used_percent"],"resources":["/","/var/lib/discord-gateway"],"drop_device":true,"metrics_collection_interval":60,"ignore_file_system_types":["sysfs","devtmpfs","tmpfs"]}
    }
  },
  "logs": {
    "force_flush_interval":5,
    "logs_collected":{"files":{"collect_list":[{
      "file_path":"/var/log/discord-gateway/gateway.log",
      "log_group_name":"/discord-management-bot/gateway",
      "log_stream_name":"{instance_id}"
    }]}}
  }
}
