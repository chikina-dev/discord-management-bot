[Unit]
Description=Consistent SQLite backup to S3
After=network-online.target discord-gateway.service
RequiresMountsFor=/var/lib/discord-gateway
[Service]
Type=oneshot
User=discord-gateway
Group=discord-gateway
UMask=0077
Environment=GOMEMLIMIT=64MiB
MemoryMax=128M
ExecStart=/usr/local/bin/discord-gateway backup
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/discord-gateway /var/log/discord-gateway
StandardOutput=append:/var/log/discord-gateway/gateway.log
StandardError=append:/var/log/discord-gateway/gateway.log
TimeoutStartSec=2700
